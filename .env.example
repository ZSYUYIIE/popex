POPEX_DATA_DIR=data
POPEX_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
POPEX_MAX_DURATION_SECONDS=1800
POPEX_MAX_FILESIZE_MB=250
POPEX_MAX_UPLOAD_MB=500
POPEX_AUDIO_QUALITY=192
POPEX_FFMPEG_BINARY=ffmpeg
POPEX_FFPROBE_BINARY=ffprobe
AUDIO_ANALYSIS_ENABLED=true
AUDIO_ANALYSIS_VERSION=baseline-librosa-v1
AUDIO_ANALYSIS_TIMEOUT_SECONDS=300
AUDIO_SILENCE_RMS_THRESHOLD=0.0001

# Optional local stem separation is disabled by default. Leave paths blank until
# a platform runtime has been installed through the documented installer.
STEM_SEPARATION_ENABLED=false
STEM_SEPARATION_VERSION=demucs-worker-v3
STEM_SEPARATION_WORKER_EXECUTABLE=
STEM_SEPARATION_RUNTIME_LOCK=
STEM_SEPARATION_CACHE_DIR=
STEM_SEPARATION_RUNTIME_PROFILE=
STEM_SEPARATION_DEVICE=cpu
STEM_SEPARATION_TIMEOUT_SECONDS=3600
